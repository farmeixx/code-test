#!/bin/sh
# Shared ALSA readiness check for the headless Channel rootfs builders.
set -eu

limit="${1:-30}"
case "$limit" in
    ''|*[!0-9]*) echo 'Invalid ALSA wait timeout' >&2; exit 2 ;;
esac

elapsed=0
while [ ! -c /dev/snd/controlC0 ]; do
    if [ "$elapsed" -ge "$limit" ]; then
        echo "Channel ALSA card /dev/snd/controlC0 did not appear in ${limit}s" >&2
        exit 1
    fi
    sleep 1
    elapsed=$((elapsed + 1))
done
