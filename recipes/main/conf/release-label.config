# Release label fragment for the shipped pin (conf/mainline.conf slot 2).
# merge_config.sh applying this fragment keeps CONFIG_LOCALVERSION fixed and
# LOCALVERSION_AUTO disabled, so setlocalversion can never append a computed
# suffix (git shas, dirty markers) to the built release: VERSION, PATCHLEVEL,
# SUBLEVEL, EXTRAVERSION and CONFIG_LOCALVERSION together are the whole
# release, reproducible on every source refresh. The local builders pin the
# same string in their own conf/release.conf.
CONFIG_LOCALVERSION="-mainline"
# CONFIG_LOCALVERSION_AUTO is not set
