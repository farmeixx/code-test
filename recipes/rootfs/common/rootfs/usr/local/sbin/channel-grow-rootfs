#!/bin/sh
# Grow the userdata root filesystem. The GPT partition written by the
# bootloader is already full size, so only the filesystem needs to grow.
# Runs on every boot; resize2fs is idempotent.
#
# The kernel may expose the root device as /dev/root (root=PARTLABEL=...),
# so the real partition is resolved through its major:minor numbers.

MAJMIN=$(awk '$5 == "/" { print $3; exit }' /proc/self/mountinfo)
ROOT_NAME=""

for devpath in /sys/class/block/*/dev; do
    if [ "$(cat "$devpath")" = "$MAJMIN" ]; then
        ROOT_NAME=$(basename "${devpath%/dev}")
        break
    fi
done

case "$ROOT_NAME" in
    mmcblk0p*)
        echo "channel-grow-rootfs: booting from userdata: /dev/$ROOT_NAME"
        resize2fs "/dev/$ROOT_NAME"
        ;;
    "")
        echo "channel-grow-rootfs: could not resolve the root device"
        ;;
    *)
        echo "channel-grow-rootfs: not booting from userdata (/dev/$ROOT_NAME), nothing to do"
        ;;
esac
